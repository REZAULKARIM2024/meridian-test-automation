{
  "name": "meridian-health-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n API,WEB -c blue,green \"npm start --prefix server\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "serve:full": "concurrently -k -n API,WEB -c blue,green \"npm start --prefix server\" \"vite preview --port 5173\"",
    "pretest:e2e": "vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.383.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
